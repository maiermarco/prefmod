citHeader('To cite package "prefmod" in publications use:')
year <- gsub("^([[:digit:]]{4})\\-[[:digit:]]{2}\\-[[:digit:]]{2}$", "\\1", meta$Date)
vers <- sprintf("R package version %s", meta$Version)
pkgn <- meta$Package
ttle <- meta$Title
urlg <- "https://doi.org/10.32614/CRAN.package.prefmod"

bibentry(
  header  = "JSS 2012 Citation",
  key     = "prefmod.jsst.2012",
  bibtype = "Article",
  title   = "{prefmod}: An {R} Package for Modeling Preferences Based on Paired Comparisons, Rankings, or Ratings",
  author  = c(person("Reinhold", "Hatzinger"), person("Regina", "Dittrich")),
  journal = "Journal of Statistical Software",
  year    = "2012",
  volume  = "48",
  number  = "10",
  pages   = "1--31",
  doi     = "10.18637/jss.v048.i10",
  
  textVersion = paste0(
    "Hatzinger, R., & Dittrich, R. (2012). ",
    "prefmod: An R Package for Modeling Preferences Based on Paired Comparisons, Rankings, or Ratings. ",
    "Journal of Statistical Software, 48(10), 1-31. ",
    "https://doi.org/10.18637/jss.v048.i10"
  )
)

bibentry(
  header  = "Package Citation",
  key     = "prefmod.package",
  bibtype = "Manual",
  title   = sprintf("{%s}: %s", meta$Package, meta$Title),
  author  = c(person("Reinhold", "Hatzinger"), person(c("Marco", "Johannes"), "Maier")),
  year    = year,
  note    = sprintf("{R} package version %s", meta$Version),
  doi     = "10.32614/CRAN.package.prefmod",
  
  textVersion = sprintf("Hatzinger, R., & Maier, M. J. (%s). %s: %s. %s. %s", year, pkgn, ttle, vers, urlg)
)
